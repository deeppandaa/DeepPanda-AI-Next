# Copy this file to .ai-next-cloud.env and set the local FreeLLMAPI key.
FREELLMAPI_API_KEY=
FREELLMAPI_CHAT_ENABLED=false
FREELLMAPI_CHAT_MODEL=auto

# Optional NVIDIA NIM. Alternatively save the key through Qt Settings > NVIDIA NIM API.
# Trial credits / quotas / billing depend on the NVIDIA account; no free access guarantee.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct