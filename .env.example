# DeepPanda-AI-Next ortam ayarları. Kopyalayın: Copy-Item .env.example .env  (gizli değerleri .env'e yazın, commit etmeyin)

# --- Yerel model (Qwen 2.5) ---
OLLAMA_MODEL=qwen2.5-coder:7b
# Boş bırakılırsa model-area-priorities.json sırası kullanılır; doluysa tüm alanlarda bu yerel Qwen modeli öne alınır.
DEEPPANDA_BRAIN_MODEL=
# Mevcut model klasörünü kullanmak için (docker-compose.models.yml ile):
# OLLAMA_MODELS_HOST_DIR=./models/ollama

# --- Host portları (hepsi yalnızca 127.0.0.1) ---
API_HOST_PORT=8787
WEB_HOST_PORT=8788
DB_MANAGER_HOST_PORT=8789
FREELLMAPI_HOST_PORT=3001
OLLAMA_HOST_PORT=11435

# --- SQL yöneticisi (docker compose --profile manager up -d db-manager) ---
# readonly | readwrite
DB_MANAGER_MODE=readonly
# Doluysa sqlite-web parola sorar.
SQLITE_WEB_PASSWORD=

# --- GitHub Copilot MCP araçları (mcp-servers.json -> github) ---
# Boş bırakılırsa Qt istemcisi "gh auth token" ile yalnızca kendi süreci için alır.
GITHUB_TOKEN=

# --- OpenJarvis (WSL Ubuntu: jarvis serve --host 0.0.0.0 --port 8010 -e ollama -m qwen2.5-coder:7b) ---
OPENJARVIS_BASE_URL=http://host.docker.internal:8010/v1
OPENJARVIS_MODEL=

# --- Web araması ---
WEB_SEARCH_PROVIDER=auto
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_SEARCH_TYPE=SEARCH_TYPE_TR
